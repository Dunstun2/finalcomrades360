# Keep Passenger directives disabled because we are using PM2
# PassengerAppRoot "/home/vdranjxy/comrades-master"
# PassengerBaseURI "/"
# PassengerAppType node
# PassengerStartupFile server.js

<IfModule mod_setenvif.c>
  # Disable compression and buffering for Socket.IO polling to prevent 503 timeouts
  SetEnvIf Request_URI "^/socket\.io" no-gzip 1
  SetEnvIf Request_URI "^/socket\.io" proxy-initial-not-pooled 1
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 0. Force HTTPS first (before proxying)
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 0b. Redirect www to non-www (canonical domain)
  RewriteCond %{HTTP_HOST} ^www\.comrades360\.shop$ [NC]
  RewriteRule ^ https://comrades360.shop%{REQUEST_URI} [L,R=301]

  # 1. Proxy WebSockets for Socket.IO when Upgrade header is present (mod_proxy_wstunnel)
  RewriteCond %{HTTP:Upgrade} websocket [NC]
  RewriteCond %{HTTP:Connection} upgrade [NC]
  RewriteRule ^socket\.io/?(.*) ws://127.0.0.1:5000/socket.io/$1 [P,L]

  # 2. Proxy Socket.IO polling with special timeout handling
  RewriteCond %{REQUEST_URI} ^/socket\.io
  RewriteRule ^(.*)$ http://127.0.0.1:5000/$1 [P,L,QSA,E=proxy-initial-not-pooled:1,E=proxy-nokeepalive:1]

  # 3. Proxy API and Uploads to PM2 Node.js app on port 5000
  RewriteCond %{REQUEST_URI} ^/api [OR]
  RewriteCond %{REQUEST_URI} ^/uploads
  RewriteRule ^(.*)$ http://127.0.0.1:5000/$1 [P,L,QSA]

  # 4. React Router SPA Routing (serve index.html for all other requests)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ /index.html [L]
</IfModule>

# 5. Long-term Browser Caching for Images & Static Assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(ico|jpe?g|png|gif|webp|svg|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
